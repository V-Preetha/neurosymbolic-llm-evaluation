{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSCE normalized benchmark record",
  "type": "object",
  "required": ["sample_id", "dataset", "task_type", "input", "candidate_response", "ground_truth", "evidence", "symbolic", "metadata", "provenance"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "dataset": {"enum": ["proofwriter", "felm"]},
    "task_type": {"enum": ["logical_reasoning", "claim_factuality"]},
    "input": {
      "type": "object",
      "required": ["question", "context", "facts", "rules"],
      "properties": {
        "question": {"type": "string"},
        "context": {"type": ["string", "null"]},
        "facts": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidate_response": {"type": "object"},
    "ground_truth": {"type": "object"},
    "evidence": {"type": "object"},
    "symbolic": {"type": "object"},
    "metadata": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
